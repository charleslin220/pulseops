# Generate independent local values. Never reuse employer credentials.
# Use a URL-safe random hexadecimal POSTGRES_PASSWORD (32+ characters).
POSTGRES_PASSWORD=
# 12–72 bytes. Used for both independent synthetic demo accounts.
SEED_PASSWORD=
APP_ORIGIN=http://localhost:5173
# Local HTTP loopback only. HTTPS environments must set true.
COOKIE_SECURE=false
